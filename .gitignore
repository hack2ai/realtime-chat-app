# ============================================================
# Real-Time Chat Application — .gitignore
# ============================================================

target/
*.jar
*.war
*.class

# Local configuration / secrets
src/main/resources/config.properties

# Runtime attachment data — never commit user files
/data/

# IDEs
.idea/
*.iml
*.iws
out/
.classpath
.project
.settings/
bin/
.vscode/
nbproject/
nb-configuration.xml

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Logs / temporary files
*.log
logs/
*.bak
*.tmp
.env
