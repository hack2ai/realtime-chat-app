# ============================================================
# Real-Time Chat Application — .gitignore
# ============================================================

target/
*.jar
*.war
*.class

# Local configuration / secrets
src/main/resources/config.properties
config.properties
.env
.env.*
secrets/
**/secrets/

docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# Local certificate / key material
*.p12
*.pfx
*.jks
*.key
*.pem

# Runtime attachment data — never commit user files
/data/
**/data/
**/attachments/

# IDEs
.idea/
*.iml
*.iws
out/
.classpath
.project
.settings/
bin/
.vscode/
nbproject/
nb-configuration.xml

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Logs / temporary files
*.log
logs/
*.bak
*.tmp
