# Keep repository text files portable and deterministic across operating systems.
* text=auto eol=lf

*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.css text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.dockerignore text eol=lf
Dockerfile text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.jar binary
*.p12 binary
*.pfx binary
*.jks binary
*.key binary
*.pem binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
