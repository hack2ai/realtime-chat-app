# Real-Time Chat Application configuration template
# Copy to config.properties for local development.
# JVM properties and environment variables override this file.

# ---------------- Database ----------------
db.host=localhost
db.port=3306
db.name=chatapp_db
db.user=chatapp_user
db.password=CHANGE_ME
db.pool.minIdle=2
db.pool.maxSize=10
db.pool.connectionTimeoutMs=5000
# Timeout for establishing a new JDBC connection, in milliseconds.
db.connectTimeoutMs=10000
# TLS is enabled by default. Disable only for trusted local development.
db.useSsl=true
# Keep false unless the MySQL server explicitly requires RSA public-key retrieval.
db.allowPublicKeyRetrieval=false

# ---------------- Server ----------------
server.port=5050
# Bind to localhost by default. Set to 0.0.0.0 only when remote clients are intended.
server.bindAddress=127.0.0.1
server.maxClients=200
# Authentication handshake timeout in milliseconds. Authenticated chat connections clear this timeout.
server.socketReadTimeoutMs=120000

# ---------------- Transport TLS ----------------
# Enable for encrypted TCP transport. Keep false for local plain-TCP development only.
tls.enabled=false
# Required when tls.enabled=true. Use a PKCS12 keystore containing the server certificate/private key.
tls.keyStorePath=config/server-keystore.p12
tls.keyStorePassword=CHANGE_ME
# Enable on the desktop client when connecting to a TLS-enabled server.
client.tls.enabled=false
# Leave blank to use the JVM's default CA trust store; set a PKCS12 path for a private/self-signed CA.
client.tls.trustStorePath=
client.tls.trustStorePassword=

# ---------------- Authentication ----------------
auth.bcrypt.strength=12
auth.session.expiryHours=24

# ---------------- Attachments ----------------
# Files are stored outside the repository and are never committed to Git.
attachments.storagePath=data/attachments
